function CAERO1writerG(fid,CAERO1,SM)
fprintf(fid,'%-8s%-8d%-8.4f%-8d%-8d%-8d%-8s%-8s%-8d\n',...
            'CAERO1',...
            CAERO1.EID,...
            CAERO1.DIH,...
            CAERO1.CP,...
            CAERO1.NY,...
            CAERO1.NX,...
            CAERO1.RFO,...
            CAERO1.TFO,...
            CAERO1.TYP);
fprintf(fid,'%-8s%-8.4f%-8.4f%-8.4f%-8.4f%-8.4f%-8.4f%-8.4f%-8.4f%-8.4f\n',...                         
            '',...
            CAERO1.CX,...
            CAERO1.CY,...
            CAERO1.CZ,...
            CAERO1.CHD,...
            CAERO1.SPN,...
            CAERO1.TPR,...
            CAERO1.SWP,...
            CAERO1.TW1,...
            CAERO1.TW2);
if SM      
    NAM=char(CAERO1.NAM);    
    fprintf(fid,'%-8s%-8d%-8.4f%-8.4f%-8d%-8s\n',...                     
                 '',...
                 CAERO1.FLP,...
                 CAERO1.FC(1),... 
                 CAERO1.FC(1),...
                 CAERO1.FNX,...
                 NAM(1:8));
end
end